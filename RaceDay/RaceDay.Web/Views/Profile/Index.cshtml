@model RaceDay.Web.Models.ProfilePageViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h1 class="page-title mb-4">My profile</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-card text-center">
            @if (!string.IsNullOrEmpty(Model.Profile.ProfilePictureUrl))
            {
                <img src="@Model.Profile.ProfilePictureUrl" class="avatar mb-3" alt="Profile picture of @Model.Profile.FirstName" />
            }
            else
            {
                <div class="avatar avatar-placeholder mb-3" role="img" aria-label="No profile picture">@Model.Initials</div>
            }

            <h2 class="card-heading mb-1">@Model.Profile.FirstName @Model.Profile.LastName</h2>
            <p class="mb-1"><span class="role-pill">@Model.Profile.Role</span></p>
            <p class="text-muted mb-4">@Model.Profile.Email</p>

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start">
                <label for="file" class="form-label">Profile picture</label>
                <input id="file" name="file" type="file" class="form-control mb-2" accept=".jpg,.jpeg,.png,.webp" required />
                <div class="form-text mb-3">JPG, PNG or WebP, up to 5 MB.</div>
                <button type="submit" class="btn btn-primary w-100">Upload picture</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="rd-card">
            <h2 class="h4 mb-3">Your details</h2>

            <form asp-action="UpdateProfile" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Form.FirstName" class="form-label"></label>
                        <input asp-for="Form.FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="Form.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Form.LastName" class="form-label"></label>
                        <input asp-for="Form.LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="Form.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.Phone" class="form-label"></label>
                    <input asp-for="Form.Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Form.Phone" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="email">Email</label>
                    <input id="email" class="form-control" value="@Model.Profile.Email" disabled />
                    <div class="form-text">Your email address is used to log in and cannot be changed here.</div>
                </div>

                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
