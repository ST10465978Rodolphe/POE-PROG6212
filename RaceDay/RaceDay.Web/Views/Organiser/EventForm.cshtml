@model RaceDay.Web.Models.EventFormViewModel
@{
    bool isEdit = Model.EventId > 0;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-card">
            <h1 class="page-title mb-4">@(isEdit ? "Edit event" : "Create event")</h1>

            <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId"
                  method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="BannerUrl" />

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="">Choose a type...</option>
                            <option value="Running">Running</option>
                            <option value="Walking">Walking</option>
                            <option value="Cycling">Cycling</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.BannerUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.BannerUrl" class="form-banner-preview" alt="Current banner" />
                        </div>
                    }
                    <input asp-for="Banner" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">
                        JPG, PNG or WebP, up to 5 MB.@(isEdit ? " Leave empty to keep the current banner." : " Optional.")
                    </div>
                    <span asp-validation-for="Banner" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
                    <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
