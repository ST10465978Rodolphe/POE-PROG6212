@model RaceDay.Web.Models.EventBrowseViewModel
@{
    ViewData["Title"] = "Browse Events";
}

<h1 class="page-title mb-1">Upcoming events</h1>
<p class="text-muted mb-4">Find your next run, walk or cycle ride.</p>

<form asp-action="Events" method="get" class="rd-card mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label for="search" class="form-label">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Event name or place" />
        </div>
        <div class="col-md-3">
            <label for="type" class="form-label">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                <option value="Running" selected="@(Model.Type == "Running")">Running</option>
                <option value="Walking" selected="@(Model.Type == "Walking")">Walking</option>
                <option value="Cycling" selected="@(Model.Type == "Cycling")">Cycling</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Events" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (Model.TotalUpcoming == 0)
{
    <div class="rd-card text-center py-5">
        <h2 class="card-heading">No upcoming events yet</h2>
        <p class="mb-0 text-muted">Check back soon. New events are added by organisers all the time.</p>
    </div>
}
else if (!Model.Events.Any())
{
    <div class="rd-card text-center py-5">
        <h2 class="card-heading">No events match your search</h2>
        <p class="text-muted">Try a different word, or show all events.</p>
        <a asp-action="Events" class="btn btn-primary">Show all events</a>
    </div>
}
else
{
    @if (Model.IsFiltered)
    {
        <p class="text-muted">Showing @Model.Events.Count of @Model.TotalUpcoming upcoming events.</p>
    }

    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rd-card event-card h-100">
                    @if (!string.IsNullOrEmpty(ev.BannerUrl))
                    {
                        <img src="@ev.BannerUrl" class="event-banner" alt="Banner for @ev.EventName" />
                    }
                    else
                    {
                        <div class="event-banner" role="img" aria-label="No banner image"></div>
                    }

                    <div class="event-card-body">
                        <h2 class="card-heading">@ev.EventName</h2>
                        <p class="event-meta mb-2">@ev.EventDate.ToString("dd MMM yyyy") &middot; @ev.Location</p>
                        <p class="mb-2">
                            <span class="type-badge">@ev.EventType</span>
                            <span class="event-distance">@ev.Distance.ToString("0.##") km</span>
                        </p>
                        <p class="small text-muted mb-3">Organised by @ev.OrganiserName</p>
                        <a asp-action="EventDetails" asp-route-id="@ev.EventId" class="btn btn-primary btn-sm">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
