@model RaceDay.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";

    string heading = Model.StatusCode switch
    {
        404 => "We could not find that page",
        403 => "You do not have access to that page",
        400 => "That request could not be completed",
        _ => "Something went wrong"
    };

    string text = Model.StatusCode switch
    {
        404 => "The page may have moved, or the address may be wrong.",
        403 => "Please log in with an account that is allowed to open this page.",
        400 => "Your form may have expired. Please go back, open the page again and try once more.",
        _ => "We ran into a problem on our side. Please try again in a moment."
    };
}

<div class="text-center py-5">
    @if (Model.StatusCode is int statusCode)
    {
        <p class="error-code">@statusCode</p>
    }

    <h1 class="page-title">@heading</h1>
    <p class="text-muted mb-4">@text</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>

    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted mt-5">Reference: @Model.RequestId</p>
    }
</div>
