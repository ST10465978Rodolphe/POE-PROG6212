@model RaceDay.Web.Models.CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rd-card">
            <h1 class="page-title mb-4">Edit category</h1>

            <form asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-id="@Model.CategoryId"
                  method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label"></label>
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="EntryFee" class="form-label"></label>
                        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="EntryFee" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
